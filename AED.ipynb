   "source": [
    "**ANÁLISE EXPLORATÓRIA DE DADOS**  \n",
    "OBJETIVO: \n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b26d96cc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Instalando as bibliotecas necessárias\n",
    "!pip install pandas\n",
    "!pip install matplotlib\n",
    "!pip install seaborn"
   ]
   "id": "922b4b24",
   "metadata": {},
   "source": [
    "Calcular medidas estatísticas básicas, como:  \n",
    "Média;  \n",
    "Mediana;  \n",
    "Valor mínimo;  \n",
    "Valor máximo;  \n",
    "Criar pelo menos um gráfico, podendo ser:  \n",
    "Histograma; ou Boxplot;\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ce0342d6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Importando as bibliotecas necessárias\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "eab4ec6c",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Importando o arquivo CSV (ler e concatenar vários arquivos)\n",
    "files = ['CSV_01.csv', 'CSV_02.csv']\n",
    "dfsalario = pd.concat((pd.read_csv(f) for f in files), ignore_index=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "251416e2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualizando as primeiras linhas do DataFrame\n",
    "dfsalario.head()"
   ]
   "source": [
    "# Visualizando as primeiras linhas do DataFrame\n",
    "dfsalario.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8a6b2469",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualizando os tipos de dados das colunas\n",
    "dfsalario.dtypes"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4c9d81fb",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualizando estatísticas descritivas do DataFrame\n",
    "dfsalario.describe().astype(int)"
   ]
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9d0761f1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualizando o valor médio da coluna \"Salario\" por departamento e cargo\n",
    "dfsalario.groupby(['DEPARTAMENTO', 'CARGO'])['SALARIO'].mean().astype(int).reset_index()"
   ]
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "182cb8c5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualizando o valor mediana da coluna \"Salario\" por departamento e cargo\n",
    "dfsalario.groupby(['DEPARTAMENTO', 'CARGO'])['SALARIO'].median().astype(int).reset_index()"
   ]
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f6801b8d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualizando o valor minimo da coluna \"Salario\" por departamento e cargo\n",
    "dfsalario.groupby(['DEPARTAMENTO', 'CARGO'])['SALARIO'].min().reset_index()"
   ]
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2f2c7c96",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualizando o valor máximo da coluna \"Salario\" por departamento e cargo.\n",
    "dfsalario.groupby(['DEPARTAMENTO','CARGO'])['SALARIO'].max().reset_index()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1b854b6f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualizando a media de salario por departamento em um gráfico de barras.\n",
    "ordem_departamentos = dfsalario.groupby('DEPARTAMENTO')['SALARIO'].mean().sort_values(ascending=False).index\n",
    "plt.figure(figsize=(15, 5))\n",
    "sns.barplot(\n",
    "    data=dfsalario.sort_values('SALARIO', ascending=False),\n",
    "    x='DEPARTAMENTO',\n",
    "    y='SALARIO',\n",
    "    order=ordem_departamentos,\n",
    "    errorbar=None,\n",
    ")\n",
    "plt.xlabel('DEPARTAMENTO')\n",
    "plt.ylabel('SALARIO')\n",
    "plt.title('Média de Salário por Departamento')\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ca782a0f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualizando a media de salario por cargo em um gráfico de barras.\n",
    "ordem_cargos = dfsalario.groupby('CARGO')['SALARIO'].mean().sort_values(ascending=False).index\n",
    "plt.figure(figsize=(12, 8))\n",
    "sns.barplot(\n",
    "    data=dfsalario.sort_values('SALARIO', ascending=False),\n",
    "    x='SALARIO',\n",
    "    y='CARGO',\n",
    "    order=ordem_cargos,\n",
    "    errorbar=None,\n",
    ")\n",
    "plt.xlabel('SALARIO (R$)')\n",
    "plt.ylabel('CARGO')\n",
    "plt.title('Média de Salário por Cargo')\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
